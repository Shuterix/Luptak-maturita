  "instructions": {
    "how_to_use": "Copy the 'unavailability' object (without the description) and paste it into MongoDB",
    "mongodb_compass": [
      "1. Open MongoDB Compass",
      "2. Connect to your database",
      "3. Navigate to your 'users' collection",
      "4. Find the user you want to update",
      "5. Click 'Edit Document'",
      "6. Find the 'unavailability' field",
      "7. Replace it with one of the unavailability objects below (copy only the unavailability part, not the description)",
      "8. Click 'Update' to save"
    ],
    "mongodb_shell": [
      "Use this command format:",
      "db.users.updateOne(",
      "  { _id: ObjectId('YOUR_USER_ID') },",
      "  { $set: { unavailability: { ...paste unavailability object here... } } }",
      ")"
    ],
    "example_shell_command": "db.users.updateOne({ _id: ObjectId('507f1f77bcf86cd799439011') }, { $set: { unavailability: { timezone: 'UTC', monday: [{ start: '08:00', end: '12:00' }], tuesday: [{ start: '08:00', end: '12:00' }], wednesday: [{ start: '08:00', end: '12:00' }], thursday: [{ start: '08:00', end: '12:00' }], friday: [{ start: '08:00', end: '12:00' }], saturday: [], sunday: [] } } })"
